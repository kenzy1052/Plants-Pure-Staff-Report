# Browser (public)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# Server only — Netlify → Site configuration → Environment variables. Never commit.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SECRET_KEY

# Phone alerts (Web Push). Generate once with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:you@example.com

# Optional AI providers — server only. Never prefix secrets with VITE_ and never commit real keys.
# Each provider is used only if its key is set. They are tried in the order below, so a failing
# or out-of-credit provider is skipped automatically and the next one answers.
#
# GEMINI_API_KEY must come from an AI Studio project that has NO billing account linked, otherwise
# Google treats it as paid and returns "402 prepayment credits are depleted" (see SETUP.md).
GEMINI_API_KEY=
GROQ_API_KEY=
# DeepSeek is optional and pay-as-you-go (very cheap); it is only the last safety net.
DEEPSEEK_API_KEY=

# Report drafting order. One name or a comma-separated list; anything not listed follows in this
# default order: gemini, groq, deepseek.
REPORT_AI_PROVIDER=gemini
REPORT_AI_MODEL=gemini-3.1-flash-lite
GROQ_REPORT_MODEL=openai/gpt-oss-120b
DEEPSEEK_REPORT_MODEL=deepseek-flash

# Voice transcription order (Groq, then Gemini; DeepSeek has no speech API).
REPORT_TRANSCRIPTION_PROVIDER=groq
REPORT_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GEMINI_TRANSCRIPTION_MODEL=gemini-3.1-flash-lite

# Base URLs. Include /v1 exactly once for Groq; DeepSeek has no /v1.
GROQ_API_URL=https://api.groq.com/openai/v1
DEEPSEEK_API_URL=https://api.deepseek.com

# Daily report recipient (Madam Ursula). Resolved from the staff profiles table, never hardcoded.
# Default: the single active profile whose name contains "Ursula". Override either way if needed:
# REPORT_RECIPIENT_USER_ID=<her profiles.id>   (exact, preferred when the name is ambiguous)
# REPORT_RECIPIENT_NAME=Ursula
